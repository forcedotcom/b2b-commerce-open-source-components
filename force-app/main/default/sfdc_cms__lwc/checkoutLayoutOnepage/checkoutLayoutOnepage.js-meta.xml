<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
  <description>Show a one-page layout at checkout.</description>
  <apiVersion>67</apiVersion>
  <isExposed>true</isExposed>
  <masterLabel>Checkout Layout One-Page</masterLabel>
  <targets>
    <target>lightningCommunity__Page</target>
    <target>lightningCommunity__Default</target>
  </targets>
  <targetConfigs>
    <targetConfig targets="lightningCommunity__Default">
      <property name="showSummaryColumn" type="Boolean" default="false" label="Show the checkout summary column"></property>
      <property name="checkoutSummaryColumnBackgroundColor" type="Color" label="Checkout Summary Background Color"></property>
      <designLayout>
        <designSection>
          <designLayoutItems>
            <designLayoutProperty name="showSummaryColumn"></designLayoutProperty>
          </designLayoutItems>
        </designSection>
        <designSection name="Styles">
          <designLayoutItems>
            <designLayoutProperty name="checkoutSummaryColumnBackgroundColor"></designLayoutProperty>
          </designLayoutItems>
        </designSection>
      </designLayout>
    </targetConfig>
  </targetConfigs>
</LightningComponentBundle>