<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
  <apiVersion>67</apiVersion>
  <isExposed>true</isExposed>
  <masterLabel>Product Pricing</masterLabel>
  <description>Displays the negotiated, original, and tax-inclusive pricing for a product on a product detail page.</description>
  <targets>
    <target>lightningCommunity__Page</target>
    <target>lightningCommunity__Default</target>
  </targets>
  <targetConfigs>
    <targetConfig targets="lightningCommunity__Page">
      <paletteSection>Open Code</paletteSection>
    </targetConfig>
    <targetConfig targets="lightningCommunity__Default">
      <property label="Show Actual Price" name="showNegotiatedPrice" type="Boolean" default="true"></property>
      <property label="Actual Price Text Color" name="negotiatedPriceTextColor" type="Color"></property>
      <property label="Actual Price Text Size" name="negotiatedPriceTextSize" type="String" datasource="java://siteforce.customComponent.datasource.SLDSFontSizeDataSource" default="small"></property>
      <property label="Actual Price Label" name="negotiatedPriceLabel" type="String" default="Your Price" translatable="true"></property>
      <property label="Show Original Price" name="showOriginalPrice" type="Boolean" default="true"></property>
      <property label="Original Price Text Color" name="originalPriceTextColor" type="Color"></property>
      <property label="Original Price Text Size" name="originalPriceTextSize" type="String" datasource="java://siteforce.customComponent.datasource.SLDSFontSizeDataSource" default="small"></property>
      <property label="Original Price Label" name="originalPriceLabel" type="String" default="Original Price" translatable="true"></property>
      <property label="Unavailable Price Label" name="unavailablePriceLabel" type="String" default="Price Unavailable" translatable="true"></property>
      <property label="Show Tax Indication" name="showTaxIndication" type="Boolean" default="true"></property>
      <property label="Tax Label" name="taxIncludedLabel" type="String" default="Tax Included" translatable="true"></property>
      <property label="Tax Label Color" name="taxLabelColor" type="Color"></property>
      <property label="Tax Label Size" name="taxLabelSize" type="String" datasource="java://siteforce.customComponent.datasource.SLDSFontSizeDataSource" default="medium"></property>
      <property label="Product Data Binding" name="product" type="String" default="{!Product.Details}"></property>
      <property label="Product Pricing Data Binding" name="productPricing" type="String" default="{!Product.Pricing}"></property>
      <property label="Product Tax Data Binding" name="productTax" type="String" default="{!Product.Tax}"></property>
      <property label="Product Variant Data Binding" name="productVariant" type="String" default="{!Product.SelectedVariant}"></property>
      <designLayout>
        <designSection>
          <designLayoutItems>
            <designLayoutProperty name="showNegotiatedPrice"></designLayoutProperty>
            <designLayoutProperty name="negotiatedPriceTextColor"></designLayoutProperty>
            <designLayoutProperty name="negotiatedPriceTextSize"></designLayoutProperty>
            <designLayoutProperty name="negotiatedPriceLabel"></designLayoutProperty>
            <designLayoutProperty name="showOriginalPrice"></designLayoutProperty>
            <designLayoutProperty name="originalPriceTextColor"></designLayoutProperty>
            <designLayoutProperty name="originalPriceTextSize"></designLayoutProperty>
            <designLayoutProperty name="originalPriceLabel"></designLayoutProperty>
            <designLayoutProperty name="unavailablePriceLabel"></designLayoutProperty>
            <designLayoutProperty name="showTaxIndication"></designLayoutProperty>
            <designLayoutProperty name="taxIncludedLabel"></designLayoutProperty>
            <designLayoutProperty name="taxLabelColor"></designLayoutProperty>
            <designLayoutProperty name="taxLabelSize"></designLayoutProperty>
            <designLayoutProperty name="product"></designLayoutProperty>
            <designLayoutProperty name="productPricing"></designLayoutProperty>
            <designLayoutProperty name="productTax"></designLayoutProperty>
            <designLayoutProperty name="productVariant"></designLayoutProperty>
          </designLayoutItems>
        </designSection>
      </designLayout>
    </targetConfig>
  </targetConfigs>
</LightningComponentBundle>