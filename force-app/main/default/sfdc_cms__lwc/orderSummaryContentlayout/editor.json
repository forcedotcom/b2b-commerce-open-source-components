                                            {
                                                "definition": "site:orderShipmentTracker",
                                                "type": "component",
                                                "attributes": {
                                                    "orderStatus": "{!Order.Details.status}"
                                                },
                                                "children": [
                                                    {
                                                        "name": "orderStatus",
                                                        "type": "region",
                                                        "children": [
                                                            {
                                                                "definition": "dxp_base:textBlock",
                                                                "type": "component",
                                                                "attributes": {
                                                                    "paddingHorizontal": "none",
                                                                    "paddingVertical": "none",
                                                                    "text": "{!Order.Details.status}",
                                                                    "textAlign": "left",
                                                                    "textDecoration": "{\"bold\": true}",
                                                                    "textColor": "#0D825D",
                                                                    "textDisplayInfo": "{\"textStyle\": \"heading-medium\", \"headingTag\": \"h3\"}"
                                                                }
                                                            }
                                                        ]
                                                    }
                                                ]
                                            },
                                            {
                                                "definition": "site:orderProducts",
