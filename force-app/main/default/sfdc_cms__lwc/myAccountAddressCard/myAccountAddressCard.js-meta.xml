<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
  <apiVersion>67</apiVersion>
  <isExposed>true</isExposed>
  <masterLabel>Address Card</masterLabel>
  <description>Displays the customer&apos;s address.</description>
  <capabilities>
    <capability>lightning__ServerRenderableWithHydration</capability>
  </capabilities>
  <targets>
    <target>lightningCommunity__Page</target>
    <target>lightningCommunity__Default</target>
  </targets>
  <targetConfigs>
    <targetConfig targets="lightningCommunity__Page">
      <paletteSection>Open Code</paletteSection>
    </targetConfig>
    <targetConfig targets="lightningCommunity__Default">
      <property label="Internationalization Data" name="rawInternationalizationData" type="String" default="{!I18n.Countries}"></property>
      <property label="Data Binding" name="item" type="String" default="{!MyAccountAddress}"></property>
      <property label="Default Badge Label" name="cardDefaultBadgeLabel" type="String" default="Default" translatable="true"></property>
      <property label="Edit Button Label" name="footerEditLabel" type="String" default="Edit" translatable="true"></property>
      <property label="Delete Button Label" name="footerDeleteLabel" type="String" default="Delete" translatable="true"></property>
    </targetConfig>
  </targetConfigs>
</LightningComponentBundle>