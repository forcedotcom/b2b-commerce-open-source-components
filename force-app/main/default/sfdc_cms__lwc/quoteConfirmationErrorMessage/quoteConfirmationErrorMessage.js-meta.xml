<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata" fqn="quoteConfirmationErrorMessage">
  <masterLabel>Quote Confirmation Error</masterLabel>
  <description>Show a message when the Quote Confirmation page isn’t available, and redirect buyers to the Quote Details page.</description>
  <apiVersion>67</apiVersion>
  <isExposed>true</isExposed>
  <capabilities>
    <capability>lightning__ServerRenderableWithHydration</capability>
  </capabilities>
  <targets>
    <target>lightningCommunity__Page</target>
    <target>lightningCommunity__Default</target>
  </targets>
  <targetConfigs>
    <targetConfig targets="lightningCommunity__Page">
      <paletteSection>Open Code</paletteSection>
    </targetConfig>
    <targetConfig targets="lightningCommunity__Default">
      <property name="buttonText" type="String" label="Button Text" default="View My Quotes" translatable="true" description="Enter a label for the button that navigates users to the My Quotes page."></property>
      <designLayout>
        <designSection>
          <designLayoutItems>
            <designLayoutProperty name="buttonText"></designLayoutProperty>
          </designLayoutItems>
        </designSection>
      </designLayout>
    </targetConfig>
  </targetConfigs>
</LightningComponentBundle>