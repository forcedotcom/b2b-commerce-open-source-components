<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
  <masterLabel>Quote Confirmation Layout</masterLabel>
  <description>Show details of requested quotes and any related error messages.</description>
  <apiVersion>67</apiVersion>
  <isExposed>true</isExposed>
  <capabilities>
    <capability>lightning__ServerRenderableWithHydration</capability>
  </capabilities>
  <targets>
    <target>lightningCommunity__Page</target>
    <target>lightningCommunity__Default</target>
  </targets>
  <targetConfigs>
    <targetConfig targets="lightningCommunity__Page">
      <paletteSection>Open Code</paletteSection>
    </targetConfig>
    <targetConfig targets="lightningCommunity__Default">
      <property name="clientState" type="String" label="Quote Confirmation Data Provider Client State Expression" default="{!QuoteDetail.ClientState}"></property>
      <property name="loaderAltText" type="String" label="Loader Alternative Text" default="Loading..."></property>
      <designLayout>
        <designSection name="Loading State Settings">
          <designLayoutItems>
            <designLayoutProperty name="loaderAltText"></designLayoutProperty>
          </designLayoutItems>
        </designSection>
        <designSection>
          <designLayoutItems>
            <designLayoutProperty name="clientState" cbVisibleIf="clientState=false"></designLayoutProperty>
          </designLayoutItems>
        </designSection>
      </designLayout>
    </targetConfig>
  </targetConfigs>
</LightningComponentBundle>