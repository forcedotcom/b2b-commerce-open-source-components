<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
  <apiVersion>64</apiVersion>
  <isExposed>true</isExposed>
  <masterLabel>Shipment Tracking</masterLabel>
  <description>Displays status progress using a customizable tracker that can show up to 5 tracking statuses.</description>
  <targets>
    <target>lightningCommunity__Page</target>
    <target>lightningCommunity__Default</target>
  </targets>
  <targetConfigs>
    <targetConfig targets="lightningCommunity__Page">
      <paletteSection>Open Code</paletteSection>
    </targetConfig>
    <targetConfig targets="lightningCommunity__Default">
      <property name="orderStatus" label="Expression" type="String" default="{!Order.Details.status}"></property>
      <property name="statusDisplayText" label="Expression" type="String" default="{!Order.Details.fields.Status.text}"></property>
      <property name="subStatus" label="Expression" type="String" default="{!Order.Details.fields.SubStatus.text}"></property>
      <property name="showOrderFailureMessage" label="Show Order Failure Message" type="Boolean" default="true" description="Show the order failure reason (sub-status) below the status text for failed orders."></property>
      <property name="trackerCardBorderColor" type="Color" default="#D9DFE7" label="Border Color"></property>
      <property name="trackerCardBorderRadius" type="IntegerSlider" min="0" max="20" default="5" label="Border Radius (0px - 20px)"></property>
      <property name="trackerCardTextColor" type="Color" label="Text Color"></property>
      <property name="showTooltip" label="Show Tooltip" type="Boolean" default="true" description="Show an information icon next to the order status text for pending and failed orders. On hover, it displays the pending or failed message depending on the order&apos;s state. Other statuses show no icon."></property>
      <property name="pendingTooltipMessage" label="Pending Tooltip Message" type="String" default="Order awaiting confirmation." translatable="true"></property>
      <property name="failedTooltipMessage" label="Failed Tooltip Message" type="String" default="Order failed. Please reach out for help." translatable="true"></property>
      <designLayout>
        <designSection>
          <designLayoutItems>
            <designLayoutProperty name="orderStatus"></designLayoutProperty>
            <designLayoutProperty name="statusDisplayText" cbVisibleIf="statusDisplayText=__never__"></designLayoutProperty>
            <designLayoutProperty name="subStatus" cbVisibleIf="subStatus=__never__"></designLayoutProperty>
            <designLayoutProperty name="showOrderFailureMessage"></designLayoutProperty>
            <designLayoutProperty name="trackerCardBorderColor"></designLayoutProperty>
            <designLayoutProperty name="trackerCardBorderRadius"></designLayoutProperty>
            <designLayoutProperty name="trackerCardTextColor"></designLayoutProperty>
          </designLayoutItems>
        </designSection>
        <designSection name="Tooltip">
          <designLayoutItems>
            <designLayoutProperty name="showTooltip"></designLayoutProperty>
            <designLayoutProperty name="pendingTooltipMessage" cbVisibleIf="showTooltip"></designLayoutProperty>
            <designLayoutProperty name="failedTooltipMessage" cbVisibleIf="showTooltip"></designLayoutProperty>
          </designLayoutItems>
        </designSection>
      </designLayout>
    </targetConfig>
  </targetConfigs>
</LightningComponentBundle>