<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
  <apiVersion>68</apiVersion>
  <isExposed>true</isExposed>
  <masterLabel>Order Template Detail</masterLabel>
  <description>Displays the order template detail page with items and actions for a single order template.</description>
  <targets>
    <target>lightningCommunity__Page</target>
    <target>lightningCommunity__Default</target>
  </targets>
  <targetConfigs>
    <targetConfig targets="lightningCommunity__Page">
      <paletteSection>Open Code</paletteSection>
    </targetConfig>
    <targetConfig targets="lightningCommunity__Default">
      <property name="orderTemplateData" type="String" label="Order Template Data Expression" default="{!OrderTemplate}"></property>
      <designLayout>
        <designSection>
          <designLayoutItems>
            <designLayoutProperty name="orderTemplateData"></designLayoutProperty>
          </designLayoutItems>
        </designSection>
      </designLayout>
    </targetConfig>
  </targetConfigs>
</LightningComponentBundle>