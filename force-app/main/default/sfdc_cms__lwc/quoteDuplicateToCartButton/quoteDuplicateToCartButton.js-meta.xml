<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
  <apiVersion>67</apiVersion>
  <isExposed>true</isExposed>
  <masterLabel>Copy Quote to Cart</masterLabel>
  <description>Button for duplicating a quote to the shopping cart</description>
  <targets>
    <target>lightningCommunity__Page</target>
    <target>lightningCommunity__Default</target>
  </targets>
  <targetConfigs>
    <targetConfig targets="lightningCommunity__Page">
      <paletteSection>Open Code</paletteSection>
    </targetConfig>
    <targetConfig targets="lightningCommunity__Default">
      <property name="quoteId" type="String" default="{!QuoteDetail.id}" label="Quote ID" description="The ID of the quote"></property>
      <property name="quoteStatus" type="String" default="{!QuoteDetail.status}" label="Quote Status" description="The current status of the quote" translatable="true"></property>
      <property name="buttonText" type="String" default="Copy to Cart" label="Button Text" translatable="true"></property>
      <property name="orderId" type="String" default="{!QuoteDetail.orderId}" label="Order ID" description="Order ID associated with the quote"></property>
      <property name="hasLineItems" type="String" default="{!QuoteDetail.hasLineItems}" label="Has Line Items" description="Whether the quote has line items from QuoteDetail."></property>
      <property name="variant" type="String" default="tertiary" label="Button Variant" datasource="java://siteforce.customComponent.datasource.ButtonStyleDataSource"></property>
      <property name="size" type="String" default="standard" label="Button Size" datasource="java://siteforce.customComponent.datasource.ButtonSizeDataSource"></property>
      <property name="width" type="String" default="stretch" label="Max Button Width" datasource="java://siteforce.customComponent.datasource.ButtonStretchDataSource"></property>
      <property name="titleText" type="String" default="Copy items to cart?" label="Header Text" translatable="true"></property>
      <property name="descriptionLabel" type="String" default="Copying this quote adds its products to your cart." label="Subtitle Text" translatable="true"></property>
      <property name="infoText" type="String" default="This action clears any existing items in your cart." label="Info Text" translatable="true"></property>
      <property name="cancelButtonLabel" type="String" default="Cancel" label="Button Text" translatable="true"></property>
      <property name="sendRequestButtonLabel" type="String" default="Copy to Cart" label="Button Text" translatable="true"></property>
      <designLayout>
        <designSection name="actionButton">
          <designLayoutItems>
            <designLayoutProperty name="quoteId" cbVisibleIf="quoteId=false"></designLayoutProperty>
            <designLayoutProperty name="quoteStatus" cbVisibleIf="quoteStatus=false"></designLayoutProperty>
            <designLayoutProperty name="orderId" cbVisibleIf="orderId=false"></designLayoutProperty>
            <designLayoutProperty name="hasLineItems" cbVisibleIf="hasLineItems=false"></designLayoutProperty>
            <designLayoutProperty name="buttonText"></designLayoutProperty>
            <designLayoutProperty name="variant"></designLayoutProperty>
            <designLayoutProperty name="size"></designLayoutProperty>
            <designLayoutProperty name="width"></designLayoutProperty>
          </designLayoutItems>
        </designSection>
        <designSection name="Header">
          <designLayoutItems>
            <designLayoutProperty name="titleText"></designLayoutProperty>
          </designLayoutItems>
        </designSection>
        <designSection name="Subtitle">
          <designLayoutItems>
            <designLayoutProperty name="descriptionLabel"></designLayoutProperty>
          </designLayoutItems>
        </designSection>
        <designSection name="Info Text">
          <designLayoutItems>
            <designLayoutProperty name="infoText"></designLayoutProperty>
          </designLayoutItems>
        </designSection>
        <designSection name="Close Button">
          <designLayoutItems>
            <designLayoutProperty name="cancelButtonLabel"></designLayoutProperty>
          </designLayoutItems>
        </designSection>
        <designSection name="Duplicate to cart Button">
          <designLayoutItems>
            <designLayoutProperty name="sendRequestButtonLabel"></designLayoutProperty>
          </designLayoutItems>
        </designSection>
      </designLayout>
    </targetConfig>
  </targetConfigs>
</LightningComponentBundle>