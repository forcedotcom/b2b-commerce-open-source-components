<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
  <apiVersion>67</apiVersion>
  <masterLabel>Self Register</masterLabel>
  <description>Displays the self-registration form for new users.</description>
  <isExposed>true</isExposed>
  <capabilities>
    <capability>lightning__ServerRenderableWithHydration</capability>
  </capabilities>
  <targets>
    <target>lightningCommunity__Page</target>
    <target>lightningCommunity__Default</target>
  </targets>
  <targetConfigs>
    <targetConfig targets="lightningCommunity__Page">
      <paletteSection>Open Code</paletteSection>
    </targetConfig>
    <targetConfig targets="lightningCommunity__Default">
      <property name="firstnameLabel" type="String" label="First Name Label" default="First Name" required="true" translatable="true"></property>
      <property name="lastnameLabel" type="String" label="Last Name Label" default="Last Name" required="true" translatable="true"></property>
      <property name="emailLabel" type="String" label="Email Label" default="Email" required="true" translatable="true"></property>
      <property name="createPasswordLabel" type="String" label="Create Password Label" default="Create Password" required="true" translatable="true"></property>
      <property name="showPhoneNumberField" type="Boolean" label="Show Phone Number Field" default="true" required="true"></property>
      <property name="phoneNumberLabel" type="String" label="Phone Number Label" default="Phone Number" required="true" translatable="true"></property>
      <property name="phoneNumberRequired" type="Boolean" default="true" label="Require Phone Number" required="true"></property>
      <property name="confirmPasswordLabel" type="String" label="Confirm Password Label" default="Confirm Password" required="true" translatable="true"></property>
      <property name="submitButtonLabel" type="String" label="Submit Button Label" default="Sign Up" required="true" translatable="true"></property>
      <property name="cancelLinkLabel" type="String" label="Cancel Link Label" default="Already have an account?" required="true" translatable="true"></property>
      <property name="includePasswordField" type="Boolean" label="Include Password Field" default="true"></property>
      <property name="startUrl" type="String" label="Start URL"></property>
      <property name="regConfirmUrl" type="String" label="Registration Confirmation URL" default="./CheckPasswordResetEmail" required="true"></property>
      <property name="rawInternationalizationData" type="String" label="Internationalization Data" default="{!I18n.Countries}"></property>
      <property name="consentData" type="String" label="Consent Data" default="{!Marketing.Subscriptions}"></property>
      <property name="additionalFields" type="SelfRegisterExtraFieldMapping" label="Additional Fields"></property>
      <designLayout>
        <designSection>
          <designLayoutItems>
            <designLayoutProperty name="firstnameLabel"></designLayoutProperty>
            <designLayoutProperty name="lastnameLabel"></designLayoutProperty>
            <designLayoutProperty name="emailLabel"></designLayoutProperty>
            <designLayoutProperty name="createPasswordLabel"></designLayoutProperty>
            <designLayoutProperty name="showPhoneNumberField"></designLayoutProperty>
            <designLayoutProperty name="phoneNumberLabel"></designLayoutProperty>
            <designLayoutProperty name="phoneNumberRequired"></designLayoutProperty>
            <designLayoutProperty name="confirmPasswordLabel"></designLayoutProperty>
            <designLayoutProperty name="submitButtonLabel"></designLayoutProperty>
            <designLayoutProperty name="cancelLinkLabel"></designLayoutProperty>
            <designLayoutProperty name="includePasswordField"></designLayoutProperty>
            <designLayoutProperty name="startUrl"></designLayoutProperty>
            <designLayoutProperty name="regConfirmUrl"></designLayoutProperty>
            <designLayoutProperty name="rawInternationalizationData" cbVisibleIf="rawInternationalizationData=false"></designLayoutProperty>
            <designLayoutProperty name="consentData" cbVisibleIf="consentData=false"></designLayoutProperty>
            <designLayoutProperty name="additionalFields"></designLayoutProperty>
          </designLayoutItems>
        </designSection>
      </designLayout>
    </targetConfig>
  </targetConfigs>
</LightningComponentBundle>