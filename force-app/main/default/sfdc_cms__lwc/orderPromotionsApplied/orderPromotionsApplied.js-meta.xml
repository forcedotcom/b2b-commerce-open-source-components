<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
  <masterLabel>Promotions</masterLabel>
  <description>Display promotions applied to the Order Summary</description>
  <apiVersion>67</apiVersion>
  <isExposed>true</isExposed>
  <targets>
    <target>lightningCommunity__Page</target>
    <target>lightningCommunity__Default</target>
  </targets>
  <targetConfigs>
    <targetConfig targets="lightningCommunity__Page">
      <paletteSection>Open Code</paletteSection>
    </targetConfig>
    <targetConfig targets="lightningCommunity__Default">
      <property name="orderPromotionDetails" type="String" default="{!Order.Adjustments}" label="Details"></property>
      <property name="promotionTitle" translatable="true" type="String" default="Applied Promotions" label="Applied Headline:"></property>
      <property name="backgroundColor" type="Color" label="Background Color"></property>
      <property name="borderColor" type="Color" label="Border Color"></property>
      <property name="borderRadius" type="Integer" min="0" max="20" default="0" label="Border Radius (0px - 20px)"></property>
      <property name="textColor" type="Color" label="Text Color"></property>
      <property name="amountTextColor" type="Color" label="Negative Price Color"></property>
      <designLayout>
        <designSection>
          <designLayoutItems>
            <designLayoutProperty name="orderPromotionDetails"></designLayoutProperty>
            <designLayoutProperty name="promotionTitle"></designLayoutProperty>
            <designLayoutProperty name="backgroundColor"></designLayoutProperty>
            <designLayoutProperty name="borderColor"></designLayoutProperty>
            <designLayoutProperty name="borderRadius"></designLayoutProperty>
            <designLayoutProperty name="textColor"></designLayoutProperty>
            <designLayoutProperty name="amountTextColor"></designLayoutProperty>
          </designLayoutItems>
        </designSection>
      </designLayout>
    </targetConfig>
  </targetConfigs>
</LightningComponentBundle>