<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
  <masterLabel>Email Sign Up Form</masterLabel>
  <description>Collect shopper email addresses for news and marketing.</description>
  <apiVersion>67</apiVersion>
  <isExposed>true</isExposed>
  <capabilities>
    <capability>lightning__ServerRenderableWithHydration</capability>
  </capabilities>
  <targets>
    <target>lightningCommunity__Page</target>
    <target>lightningCommunity__Default</target>
  </targets>
  <targetConfigs>
    <targetConfig targets="lightningCommunity__Page">
      <paletteSection>Open Code</paletteSection>
    </targetConfig>
    <targetConfig targets="lightningCommunity__Default">
      <property name="inputFieldLabel" type="String" default="Email Address" translatable="true" label="Email Address Label"></property>
      <property name="placeholderText" type="String" default="Enter your email address" translatable="true" label="Email Address Placeholder Text"></property>
      <property name="successMessage" type="String" default="Thank you for signing up!" translatable="true" label="Confirmation Text"></property>
      <property name="buttonText" type="String" default="Subscribe" translatable="true" label="Submit Button Label"></property>
      <property name="subscriptions" type="String" default="{!Marketing.Subscriptions.communications}" label="Subscriptions Expression"></property>
      <designLayout>
        <designSection>
          <designLayoutItems>
            <designLayoutProperty name="inputFieldLabel"></designLayoutProperty>
            <designLayoutProperty name="placeholderText"></designLayoutProperty>
            <designLayoutProperty name="buttonText"></designLayoutProperty>
            <designLayoutProperty name="successMessage"></designLayoutProperty>
          </designLayoutItems>
        </designSection>
      </designLayout>
    </targetConfig>
  </targetConfigs>
</LightningComponentBundle>