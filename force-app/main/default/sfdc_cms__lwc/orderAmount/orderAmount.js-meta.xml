<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
  <masterLabel>Order Amount</masterLabel>
  <description>Select the fields to show for order costs.</description>
  <apiVersion>67</apiVersion>
  <isExposed>true</isExposed>
  <targets>
    <target>lightningCommunity__Page</target>
    <target>lightningCommunity__Default</target>
  </targets>
  <targetConfigs>
    <targetConfig targets="lightningCommunity__Page">
      <paletteSection>Open Code</paletteSection>
    </targetConfig>
    <targetConfig targets="lightningCommunity__Default">
      <property name="orderSummaryDetails" type="String" default="{!Order.Details}" label="Order Summary"></property>
      <property name="orderDiscounts" type="String" default="{!Order.Adjustments}" label="Order Promotions"></property>
      <property name="totalsCardTitle" translatable="true" type="String" default="Totals" label="Title"></property>
      <property name="hideTitle" type="Boolean" default="false" label="Hide title"></property>
      <property name="totalsCardBackgroundColor" type="Color" label="Background Color"></property>
      <property name="totalsCardBorderColor" type="Color" label="Border Color"></property>
      <property name="totalsCardBorderRadius" type="Integer" min="0" max="20" default="0" label="Border Radius (0px - 20px)"></property>
      <property name="totalsCardTextColor" type="Color" label="Text Color"></property>
      <property name="hideFieldValueSeparator" type="Boolean" default="false" label="Hide colon (:)"></property>
      <property name="showHorizontalLineAboveLastField" type="Boolean" default="true" label="Add a line above the last field"></property>
      <property name="showLastFieldAsBold" type="Boolean" default="true" label="Use bold font for the last field"></property>
      <property name="netTaxOrdersFieldMapping" translatable="true" default="[]" type="OrderAmountTotalsNetTaxFieldsMapping" label="Net Tax Fields" description="Select the fields to show for order costs."></property>
      <property name="grossTaxOrdersFieldMapping" translatable="true" default="[]" type="OrderAmountTotalsGrossTaxFieldsMapping" label="Gross Tax Fields" description="Select the fields to show for order costs."></property>
      <designLayout>
        <designSection>
          <designLayoutItems>
            <designLayoutProperty name="orderSummaryDetails"></designLayoutProperty>
            <designLayoutProperty name="orderDiscounts"></designLayoutProperty>
            <designLayoutProperty name="totalsCardTitle"></designLayoutProperty>
            <designLayoutProperty name="hideTitle"></designLayoutProperty>
            <designLayoutProperty name="totalsCardBackgroundColor"></designLayoutProperty>
            <designLayoutProperty name="totalsCardBorderColor"></designLayoutProperty>
            <designLayoutProperty name="totalsCardBorderRadius"></designLayoutProperty>
            <designLayoutProperty name="totalsCardTextColor"></designLayoutProperty>
            <designLayoutProperty name="hideFieldValueSeparator"></designLayoutProperty>
            <designLayoutProperty name="showHorizontalLineAboveLastField"></designLayoutProperty>
            <designLayoutProperty name="showLastFieldAsBold"></designLayoutProperty>
          </designLayoutItems>
        </designSection>
        <designSection name="Net Tax Orders">
          <designLayoutItems>
            <designLayoutProperty name="netTaxOrdersFieldMapping"></designLayoutProperty>
          </designLayoutItems>
        </designSection>
        <designSection name="Gross Tax Orders">
          <designLayoutItems>
            <designLayoutProperty name="grossTaxOrdersFieldMapping"></designLayoutProperty>
          </designLayoutItems>
        </designSection>
      </designLayout>
    </targetConfig>
  </targetConfigs>
</LightningComponentBundle>