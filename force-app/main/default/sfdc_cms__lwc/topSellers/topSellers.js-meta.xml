<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
  <apiVersion>67</apiVersion>
  <isExposed>true</isExposed>
  <masterLabel>Shop by Category</masterLabel>
  <description>Displays Top Seller products by loading the products in a given category.</description>
  <targets>
    <target>lightningCommunity__Page</target>
    <target>lightningCommunity__Default</target>
  </targets>
  <targetConfigs>
    <targetConfig targets="lightningCommunity__Page">
      <paletteSection>Open Code</paletteSection>
    </targetConfig>
    <targetConfig targets="lightningCommunity__Default">
      <property label="Category Id" type="String" name="categoryId"></property>
      <property label="Header Text" type="String" name="headerText" default="Top Sellers"></property>
      <property label="Page Size" type="Integer" name="pageSize" min="2" max="8" default="6"></property>
      <property label="Browse Step" type="Integer" name="browseStep" min="1" max="3" default="1"></property>
      <designLayout>
        <designSection>
          <designLayoutItems>
            <designLayoutProperty name="categoryId"></designLayoutProperty>
            <designLayoutProperty name="headerText"></designLayoutProperty>
            <designLayoutProperty name="pageSize"></designLayoutProperty>
            <designLayoutProperty name="browseStep"></designLayoutProperty>
          </designLayoutItems>
        </designSection>
      </designLayout>
    </targetConfig>
  </targetConfigs>
</LightningComponentBundle>